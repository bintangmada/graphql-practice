# SCHEMA GRAPHQL TERHUBUNG KE MYSQL

type Author {
    id: ID!
    name: String!
    books: [Book]
}

type Book {
    id: ID!
    title: String!
    year: Int!
    author: Author
}

# Operasi Baca (Read)
type Query {
    books(search: String): [Book]
    book(id: ID!): Book
    authors: [Author]
    author(id: ID!): Author
}

# Operasi Ubah & Tulis (CRUD: Create, Update, Delete)
type Mutation {
    # CRUD Penulis
    createAuthor(name: String!): Author
    deleteAuthor(id: ID!): Boolean

    # CRUD Buku
    createBook(title: String!, year: Int!, authorId: ID!): Book
    updateBook(id: ID!, title: String, year: Int): Book
    deleteBook(id: ID!): Boolean
}
